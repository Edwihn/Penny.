{
  "name": "penny-expense-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "playwright test"
  },
  "devDependencies": { "concurrently": "^9.2.0", "@playwright/test": "^1.55.0" }
}
